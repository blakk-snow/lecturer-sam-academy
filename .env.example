# Lecturer Sam Academy — Server + Firebase Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── OpenRouter (AI proxy) ──────────────────────────────────────────────────────
# Your OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The URL of your deployed site (used in OpenRouter HTTP-Referer header)
SITE_URL=http://localhost:5173

# The display name sent to OpenRouter
SITE_NAME=Lecturer Sam Academy

# Restrict AI proxy CORS to this origin (set to your Vercel URL in production)
# ALLOWED_ORIGIN=https://lecturer-sam-academy.vercel.app

# Optional: override the proxy server port (default 3001)
# SERVER_PORT=3001

# ── Firebase (client-side, safe to expose) ────────────────────────────────────
# Get these from Firebase console → Project Settings → Your apps → Web app
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
