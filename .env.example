# Number Academy — AI Proxy Server Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Your OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# The URL of your deployed site (used in OpenRouter HTTP-Referer header)
SITE_URL=http://localhost:5173

# The display name sent to OpenRouter
SITE_NAME=Number Academy

# Optional: override the proxy server port (default 3001)
# SERVER_PORT=3001
